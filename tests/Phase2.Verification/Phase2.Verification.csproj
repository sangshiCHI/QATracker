<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SourceRoot Condition="'$(SourceRoot)' == ''">../../src/Companion.Diagnostics</SourceRoot>
    <RestorePackagesPath>../../.packages</RestorePackagesPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <Compile Include="$(SourceRoot)/SaveSource.cs" Link="Production/SaveSource.cs" />
    <Compile Include="$(SourceRoot)/StatisticsEngine.cs" Link="Production/StatisticsEngine.cs" />
    <Compile Include="$(SourceRoot)/SessionStore.cs" Link="Production/SessionStore.cs" />
    <Compile Include="$(SourceRoot)/Models.cs" Link="Production/Models.cs" />
    <Compile Include="$(SourceRoot)/SelfTests.cs" Link="Production/SelfTests.cs" />
  </ItemGroup>
</Project>
